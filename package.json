{
  "name": "taller-os",
  "version": "0.1.0",
  "private": true,
  "description": "TallerOS — identidad y acceso, Fase 2 pendiente de validación SQL/RLS",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @talleros/api\" \"npm run dev -w @talleros/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @talleros/contracts && npm run build -w @talleros/web && npm run build -w @talleros/api",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --schema public,private --level warning --fail-on warning",
    "db:test": "supabase test db",
    "verify:config": "node scripts/verify-config.mjs",
    "predev": "npm run build -w @talleros/web",
    "test:integration": "node scripts/tenant-integration.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "smol-toml": "1.9.0",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
